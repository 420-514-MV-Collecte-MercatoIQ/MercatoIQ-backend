                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Health payload matches API contract', function () {",
                  "  pm.expect(json.service).to.eql('MercatoIQ API');",
                  "  pm.expect(json.version).to.eql('v1');",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(Number.isNaN(Date.parse(json.timestamp))).to.eql(false);",
                  "});"
