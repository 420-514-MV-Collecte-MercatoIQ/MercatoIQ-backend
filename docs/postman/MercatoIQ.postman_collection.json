    {
      "name": "Players (Silver CRUD & Data)",
      "item": [
        {
          "name": "List Players",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List Players returns 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Pagination metadata and real Silver players data exist', function () {",
                  "  pm.expect(json.meta).to.be.an('object');",
                  "  pm.expect(json.meta.page).to.eql(1);",
                  "  pm.expect(json.meta.limit).to.eql(20);",
                  "  pm.expect(json.meta.total).to.be.a('number').and.above(0);",
                  "  pm.expect(json.meta.totalPages).to.be.a('number').and.at.least(1);",
                  "  pm.expect(json.data).to.be.an('array').and.not.empty;",
                  "});",
                  "pm.test('Every player matches filter and descending market value order', function () {",
                  "  for (let i = 0; i < json.data.length; i++) {",
                  "    const p = json.data[i];",
                  "    pm.expect(p.player_id).to.be.a('number');",
                  "    pm.expect(p.player_name).to.be.a('string').and.not.empty;",
                  "    pm.expect(p.position).to.eql('Attack');",
                  "    if (i > 0 && p.current_market_value_eur != null && json.data[i - 1].current_market_value_eur != null) {",
                  "      pm.expect(json.data[i - 1].current_market_value_eur).to.be.at.least(p.current_market_value_eur);",
                  "    }",
                  "  }",
                  "});",
                  "pm.environment.set('existing_player_id', String(json.data[0].player_id));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/players?page=1&limit=20&position=Attack",
              "host": ["{{base_url}}"],
              "path": ["players"],
              "query": [
                { "key": "page", "value": "1" },
